{
  "name": "@csisp/supabase-sdk",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm gen:types && tsc -p tsconfig.json",
    "gen:types": "tsx scripts/gen-types.ts",
    "gen:types:local": "tsx scripts/gen-types.ts --env local",
    "format:types": "prettier --write src/types/type.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9"
  },
  "devDependencies": {
    "supabase": ">=1.8.1"
  }
}
